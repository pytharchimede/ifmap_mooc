{
    "name": "cinetpay-dev/cinetpay-php",
    "description": "Official PHP SDK for the CinetPay REST API.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "cinetpay",
        "payment",
        "mobile-money",
        "transfer",
        "sdk"
    ],
    "homepage": "https://github.com/cinetpay/cinetpay-php-sdk",
    "support": {
        "email": "support@cinetpay.com",
        "issues": "https://github.com/cinetpay/cinetpay-php-sdk/issues"
    },
    "require": {
        "ext-json": "*",
        "ext-mbstring": "*",
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "CinetPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CinetPay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress",
        "test": "phpunit",
        "test:coverage": [
            "@php vendor/bin/phpunit --coverage-clover=coverage.xml",
            "@php tools/assert-coverage.php coverage.xml 100"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
